# Bez listingu katalogów — poza blokiem <IfModule mod_negotiation.c> niżej, bo
# na realnym hostingu tego modułu nie było i /storage/ pokazywał wszystkim
# listę zdjęć wszystkich przedmiotów.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Appka jest w tym samym katalogu co index.php (brak osobnego document
# rootu) — te pliki w korzeniu NIE mogą być pobierane wprost przez
# przeglądarkę (zawierają hasła do bazy / klucz appki).
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|VERSION|update-manifest\.json|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# app-storage (sesje/cache/logi/baza — prawdziwy storage/ appki) blokowany
# PO ADRESIE URL, nie zagnieżdżonym .htaccess w środku katalogu — inaczej
# blokada objęłaby też app-storage/app/public, do którego prowadzi symlink
# "storage" (Apache stosuje reguły dostępu po prawdziwej ścieżce docelowej
# symlinka, nie po jego nazwie), i zdjęcia/QR znowu dawałyby 403 mimo
# poprawnego symlinku.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/app-storage/
    RewriteRule .* - [F,L]

    # Ukryte pliki i katalogi (.git, .github, .env.backup...) oraz dokumentacja
    # .md — paczka aktualizacji ich nie zawiera, ale instalacja przez
    # `git clone` prosto na hosting wystawiłaby całą historię repozytorium.
    # .well-known zostaje dostępne (certyfikaty Let's Encrypt).
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_URI} (^|/)\. [OR]
    RewriteCond %{REQUEST_URI} \.md$ [NC]
    RewriteRule .* - [F,L]

    # /storage/ (symlink do app-storage/app/public) udostępnia tylko to, czego
    # appka faktycznie używa publicznie: zdjęcia i załączniki przedmiotów, kody
    # QR, logo/favicon. Wszystko inne, co mogło tam trafić (np. stare katalogi
    # app/, framework/, logs/ z dawnego układu, znalezione realnie na
    # produkcji razem z migawkami kodu), jest niedostępne z zewnątrz.
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteCond %{REQUEST_URI} !^/storage/(items|qr|branding)/
    RewriteRule .* - [F,L]

    # Drugie zabezpieczenie: nawet gdyby w /storage/ znalazł się skrypt (np.
    # wgrany jako załącznik), serwer go nie uruchomi ani nie poda jako strony.
    RewriteCond %{REQUEST_URI} ^/storage/ [NC]
    RewriteCond %{REQUEST_URI} \.(php[0-9]?|phtml|phar|pht|phps|cgi|pl|py|sh|html?|shtml|xhtml|js|mjs)$ [NC]
    RewriteRule .* - [F,L]
</IfModule>
